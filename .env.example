# Host address/port to listen on (set BIND_ADDR to your Tailscale/VPN IP to keep it off the LAN)
BIND_ADDR=0.0.0.0
PORT=7681

# Browser login. Empty = no password.
AUTH_USER=user
AUTH_PASSWORD=change-me

# Extra ttyd flags, e.g. -t fontSize=16
TTYD_ARGS=

# Agent: claude | opencode | codex
AGENT=claude

TTYD_VERSION=1.7.7

# uid/gid the container runs as (must own DATA and WORKSPACE)
PUID=1000
PGID=1000

# Container HOME (binaries, agent login and config) and folder mounted at /workspace
DATA=./data
WORKSPACE=./workspace
