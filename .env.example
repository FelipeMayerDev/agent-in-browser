# Porta/endereço expostos no host (use o IP do tailscale em BIND_ADDR pra não expor na LAN)
BIND_ADDR=0.0.0.0
PORT=7681

# Basic auth do ttyd (usuario:senha). Vazio = sem senha.
TTYD_CREDENTIAL=usuario:troque-esta-senha

# Flags extras do ttyd, ex: -t fontSize=16 -t theme={"background":"#1e1e2e"}
TTYD_ARGS=

# Comando que roda em cada conexão
AGENT_CMD=claude

# Versões fixadas no build (docker compose build pra aplicar)
CLAUDE_VERSION=latest
TTYD_VERSION=1.7.7

# Config/login do Claude (CLAUDE_CONFIG_DIR) e pasta de trabalho montada em /workspace
CLAUDE_DATA=./data/claude
WORKSPACE=./workspace
