# Porta/endereço expostos no host (use o IP do tailscale em BIND_ADDR pra não expor na LAN)
BIND_ADDR=0.0.0.0
PORT=7681

# Login do navegador. Vazio = sem senha.
AUTH_USER=usuario
AUTH_PASSWORD=troque-esta-senha

# Flags extras do ttyd, ex: -t fontSize=16
TTYD_ARGS=

# Agente: claude | opencode | codex
AGENT=claude

TTYD_VERSION=1.7.7

# uid/gid que roda no container (dono de DATA e WORKSPACE)
PUID=1000
PGID=1000

# HOME do container (binários, login e config do agente) e pasta montada em /workspace
DATA=./data
WORKSPACE=./workspace
